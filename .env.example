# Never put exchange keys in this file. This release is PAPER ONLY.
TRADING_MODE=paper
TRADING_MARKET=BTCUSDT
PAPER_START_EQUITY=10000
RISK_PER_TRADE_PCT=0.01
MAX_DAILY_LOSS_PCT=0.03
MAX_LEVERAGE=2
FEE_BPS=6
SLIPPAGE_BPS=2
ENABLE_WHALE=false
POLL_SECONDS=60
# Local Python only. Containers use /app/data explicitly.
DATA_DIR=data
# Required for dashboard; username is admin. Generate a unique random value:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
DASHBOARD_PASSWORD=
